{
	"$schema": "node_modules/wrangler/config-schema.json",
	"account_id": "324e23339afefd2f1f689e735c2b8789",
	"name": "impulse-map",
	"main": "src/worker/index.ts",
	"compatibility_date": "2026-08-15",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "impulse-map",
			"database_id": "788ebf6a-abcf-4f2f-b92e-f585a0bd4212",
			"migrations_dir": "migrations"
		}
	]
}